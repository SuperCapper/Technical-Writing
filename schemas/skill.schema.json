{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SuperCapper/Technical-Writing/schemas/skill.schema.json",
  "title": "Technical Writing Skill",
  "description": "A single reusable Claude skill distilled from one chapter of Technical Writing for Engineers and Scientists (ISE). Each skill is a self-contained instruction set for drafting, reviewing, or revising a specific kind of technical document or technique.",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "category",
    "description",
    "target_input",
    "output_format",
    "system_prompt",
    "user_prompt_template",
    "examples",
    "source"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+$",
      "description": "Unique dot-separated identifier: category.skill-name"
    },
    "name": { "type": "string" },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "category": {
      "type": "string",
      "enum": ["foundations", "elements", "genres", "style-support", "workplace"]
    },
    "description": { "type": "string" },
    "target_input": { "type": "string", "enum": ["markdown", "text", "outline"] },
    "output_format": { "type": "string", "enum": ["markdown", "text"] },
    "parameters": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "description": { "type": "string" },
          "enum": { "type": "array" },
          "default": {}
        },
        "required": ["type"]
      }
    },
    "system_prompt": { "type": "string" },
    "user_prompt_template": { "type": "string" },
    "checklist": {
      "type": "array",
      "items": { "type": "string" },
      "description": "The book's own end-of-chapter checklist, used both as prompt content and as a post-hoc review rubric."
    },
    "examples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["description", "input", "expected_output"],
        "properties": {
          "description": { "type": "string" },
          "context": { "type": "object" },
          "input": { "type": "string" },
          "expected_output": { "type": "string" }
        }
      }
    },
    "source": {
      "type": "object",
      "required": ["book", "chapter", "chapter_title"],
      "properties": {
        "book": { "type": "string" },
        "chapter": { "type": "integer" },
        "chapter_title": { "type": "string" }
      }
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" }
    },
    "model": { "type": "string" },
    "max_tokens": { "type": "integer" },
    "thinking": { "type": "boolean" },
    "chunking": { "type": "string", "enum": ["safe", "unsafe"] },
    "changelog": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "version": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
